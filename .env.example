# ==========================================
# 1. DOMAIN & NETWORKING (REQUIRED FOR HOSTING)
# ==========================================
# The public URL where the frontend will be accessible
# Example: https://hackathon.yourdomain.com
CLIENT_URL=http://localhost:3000

# The public URL where the backend API is reachable by visitors' browsers
# If using reverse proxy (e.g., Nginx / Traefik / Caddy) under a subdomain:
# Example: https://api.hackathon.yourdomain.com
# Or if proxying /api on the same domain: https://hackathon.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# ==========================================
# 2. SECURITY SECRETS (CHANGE IN PRODUCTION!)
# ==========================================
# A long, random secret key (e.g., generated with `openssl rand -base64 32`)
JWT_SECRET=super_secret_devops_hackathon_key_2026

# Administrator credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_strong_password_123

# ==========================================
# 3. DATABASE (POSTGRESQL)
# ==========================================
POSTGRES_USER=devops
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=hackathon
DATABASE_URL=postgresql://devops:change_this_db_password@postgres:5432/hackathon?schema=public

# ==========================================
# 4. EMAIL / SMTP (FOR TEAM REGISTRATION EMAILS)
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_api_key

# ==========================================
# 5. PORTS
# ==========================================
PORT=5000
FRONTEND_PORT=3000
